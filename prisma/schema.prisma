// CodeQuest Academy - Prisma schema
// This is a starting-point schema derived from CLAUDE.md section 34 (Database Design).
// It is NOT complete or final - it covers core identity, curriculum, and progress models
// so that Claude Code has a concrete foundation to extend, migrate, and refine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Identity & Access ----------

enum UserRole {
  OWNER
  ADMIN
  CURRICULUM_EDITOR
  LEARNER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  role          UserRole  @default(LEARNER)
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  settings      UserSettings?
  invitationsSent   Invitation[]      @relation("InvitationsSent")
  lessonProgress    LessonProgress[]
  missionAttempts   MissionAttempt[]
  userSkills        UserSkill[]
  achievements      UserAchievement[]
  notifications     Notification[]
  notes             Note[]
  bookmarks         Bookmark[]
  savedCode         SavedCode[]
  streak            Streak?
  auditLogs         AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  role        UserRole  @default(LEARNER)
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User @relation("InvitationsSent", fields: [invitedById], references: [id])
}

// ---------- User configuration ----------

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String?
  avatarUrl      String?
  experienceSelf String?
  goals          String?
  dailyGoalXp    Int      @default(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  theme             String  @default("dark")
  reducedMotion     Boolean @default(false)
  aiTutorEnabled    Boolean @default(false)
  emailNotifications Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Curriculum ----------

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model World {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String?
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)

  modules   Module[]
}

model Module {
  id        String        @id @default(cuid())
  worldId   String
  slug      String
  title     String
  summary   String?
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)

  world     World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@unique([worldId, slug])
}

model Lesson {
  id           String        @id @default(cuid())
  moduleId     String
  slug         String
  title        String
  order        Int           @default(0)
  status       ContentStatus @default(DRAFT)
  content      Json
  version      Int           @default(1)

  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  missions        Mission[]
  lessonProgress  LessonProgress[]
  lessonSkills    LessonSkill[]

  @@unique([moduleId, slug])
}

model Mission {
  id             String        @id @default(cuid())
  lessonId       String
  slug           String
  title          String
  type           String
  status         ContentStatus @default(DRAFT)
  starterCode    String?
  solutionCode   String?
  explanation    String?
  xpReward       Int           @default(10)
  difficulty     Int           @default(1)

  lesson         Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tests          MissionTest[]
  hints          MissionHint[]
  attempts       MissionAttempt[]
  missionSkills  MissionSkill[]

  @@unique([lessonId, slug])
}

model MissionTest {
  id         String  @id @default(cuid())
  missionId  String
  isHidden   Boolean @default(false)
  input      Json?
  expected   Json?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model MissionHint {
  id         String @id @default(cuid())
  missionId  String
  level      Int
  content    String

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, level])
}

model Skill {
  id            String @id @default(cuid())
  slug          String @unique
  name          String
  description   String?

  lessonSkills  LessonSkill[]
  missionSkills MissionSkill[]
  userSkills    UserSkill[]
}

model LessonSkill {
  lessonId String
  skillId  String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([lessonId, skillId])
}

model MissionSkill {
  missionId String
  skillId   String

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([missionId, skillId])
}

// ---------- Progress ----------

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  startedAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model MissionAttempt {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  attemptNo   Int      @default(1)
  hintLevel   Int      @default(0)
  passed      Boolean  @default(false)
  score       Int      @default(0)
  xpAwarded   Int      @default(0)
  submittedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

enum MasteryLevel {
  NOT_STARTED
  INTRODUCED
  PRACTICING
  DEVELOPING
  PROFICIENT
  MASTERED
  NEEDS_REVIEW
}

model UserSkill {
  id          String       @id @default(cuid())
  userId      String
  skillId     String
  masteryScore Int         @default(0)
  masteryLevel MasteryLevel @default(NOT_STARTED)
  updatedAt   DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String?

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ---------- Personal learning data ----------

model Note {
  id        String   @id @default(cuid())
  userId    String
  content   String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  targetType String
  targetId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedCode {
  id        String   @id @default(cuid())
  userId    String
  title     String
  code      String
  language  String   @default("javascript")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Communication and operations ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model FeatureFlag {
  id        String  @id @default(cuid())
  key       String  @unique
  enabled   Boolean @default(false)
  notes     String?
}
