# Environment Variable Template
#
# Copy this file to .env.local (for local development) and fill in real values.
# Never commit an actual .env or .env.local file with real secrets.
# This file must only ever contain placeholder names and example formats.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CodeQuest Academy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# ---------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://placeholder_user:placeholder_password@localhost:5432/codequest_dev"
DIRECT_URL="postgresql://placeholder_user:placeholder_password@localhost:5432/codequest_dev"

# ---------------------------------------------------------------------------
# Authentication / Sessions
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-generated-random-secret"
AUTH_URL="http://localhost:3000"
SESSION_COOKIE_NAME="codequest_session"

# ---------------------------------------------------------------------------
# Email (optional at launch)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="console"
EMAIL_FROM_ADDRESS="no-reply@example.com"
EMAIL_API_KEY="replace-with-real-provider-key"

# ---------------------------------------------------------------------------
# AI Provider (optional, feature-flagged)
# ---------------------------------------------------------------------------
AI_TUTOR_ENABLED="false"
AI_PROVIDER="anthropic"
AI_API_KEY="replace-with-real-provider-key"

# ---------------------------------------------------------------------------
# Error Tracking / Observability (optional)
# ---------------------------------------------------------------------------
ERROR_TRACKING_DSN="replace-with-real-dsn-if-used"

# ---------------------------------------------------------------------------
# Rate Limiting (optional, depends on chosen provider)
# ---------------------------------------------------------------------------
RATE_LIMIT_PROVIDER_URL="replace-with-real-url-if-used"
RATE_LIMIT_PROVIDER_TOKEN="replace-with-real-token-if-used"

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
FEATURE_PUBLIC_REGISTRATION="false"
FEATURE_EMAIL_NOTIFICATIONS="false"
FEATURE_GITHUB_IMPORT="false"
FEATURE_SERVER_CODE_EXECUTION="false"
FEATURE_MAINTENANCE_MODE="false"
